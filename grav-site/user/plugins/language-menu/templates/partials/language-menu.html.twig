<nav class="languages va-language-menu" data-language-menu aria-label="Languages">{% for item in pages.children.visible.order('header.language_sort', 'asc') %}<a data-language="{{ item.header.language_code|e('html_attr') }}" href="{{ item.url }}" lang="{{ item.header.language_code == 'sasl' ? 'en' : item.header.language_code|e('html_attr') }}" {% if item.header.language_code == page.header.language_code %}aria-current="page"{% endif %}>{{ item.header.language_name|default(item.title)|e }}</a>{% endfor %}</nav>

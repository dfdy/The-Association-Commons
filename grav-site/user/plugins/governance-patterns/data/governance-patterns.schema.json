{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DDC governance patterns",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "language",
    "updated_at",
    "description",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "en"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "problem",
          "draft_clause",
          "accessibility",
          "suitable_when",
          "unsuitable_when",
          "how_it_works",
          "local_choices",
          "risks_and_safeguards",
          "legal_record_ids",
          "category",
          "provision_type",
          "legal_review_status",
          "testing_status",
          "test_evidence",
          "last_tested",
          "reviewer",
          "review_due",
          "generator_ready",
          "updated_at",
          "sources",
          "change_history",
          "legal_reviewed_on",
          "legal_reviewer",
          "legal_review_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "draft_clause": {
            "type": "string",
            "minLength": 1
          },
          "accessibility": {
            "type": "string",
            "minLength": 1
          },
          "suitable_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unsuitable_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "how_it_works": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "local_choices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks_and_safeguards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "legal_record_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "category": {
            "enum": [
              "contributions",
              "hardship",
              "facilitation",
              "reviewers",
              "federation",
              "conflict",
              "accessible_meetings"
            ]
          },
          "provision_type": {
            "enum": [
              "democratic_choice",
              "prudent_safeguard",
              "institutional_pattern"
            ]
          },
          "legal_review_status": {
            "enum": [
              "not_reviewed",
              "reviewed",
              "needs_review"
            ]
          },
          "testing_status": {
            "enum": [
              "untested_draft",
              "in_testing",
              "tested",
              "retired"
            ]
          },
          "test_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "context",
                "findings",
                "limitations",
                "reference"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "context": {
                  "type": "string",
                  "minLength": 1
                },
                "findings": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "last_tested": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_due": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "generator_ready": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "string",
            "format": "date"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "url",
                "locator"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^(https://|/en/)"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "change_history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "note"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "legal_reviewed_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "legal_reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "legal_review_notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "testing_status": {
                  "const": "tested"
                }
              }
            },
            "then": {
              "properties": {
                "last_tested": {
                  "type": "string",
                  "format": "date"
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "test_evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "generator_ready": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "testing_status": {
                  "const": "tested"
                },
                "legal_review_status": {
                  "const": "reviewed"
                },
                "review_due": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "legal_review_status": {
                  "const": "reviewed"
                }
              }
            },
            "then": {
              "properties": {
                "legal_reviewed_on": {
                  "type": "string",
                  "format": "date"
                },
                "legal_reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "legal_review_notes": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}

{# Wrap plain Markdown tables only; custom plugin tables manage their own regions. #}
{% for fragment in page.content|split('</table>') %}
{% if '<table>' in fragment %}{{ fragment|replace({'<table>': '<div class="table-scroll" role="region" aria-label="Scrollable table" tabindex="0"><table>'})|raw }}</table></div>{% else %}{{ fragment|raw }}{% if not loop.last %}</table>{% endif %}{% endif %}
{% endfor %}

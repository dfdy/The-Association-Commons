{% set labels = navigation_labels[code]|default(navigation_labels.en) %}
<nav class="sections" aria-label="{{ labels[3]|e('html_attr') }}" lang="{{ (code == 'sasl' ? 'en' : code)|e('html_attr') }}">
{% for section in [{'path': '/' ~ code, 'label': labels[0]}, {'path': '/' ~ code ~ '/stadgar', 'label': labels[1]}, {'path': '/' ~ code ~ '/donate', 'label': labels[2]}] %}
<a href="{{ section.path|e('html_attr') }}"{% if (loop.index == 1 and page.template == 'proposal') or (loop.index == 2 and page.template == 'stadgar') or (loop.index == 3 and page.slug == 'donate') %} aria-current="page"{% endif %}>{{ section.label|e }}</a>
{% endfor %}
</nav>
